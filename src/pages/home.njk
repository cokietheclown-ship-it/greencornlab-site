---
pagination:
  data: pages.home
  size: 1
  alias: target
permalink: "/{{ target.lang }}/"
bodyClass: "punk"
---
<div class="punk">

  {#- 屋号は画像のロゴではなく文字で組み、画面幅いっぱいに張る。
      真下がすぐ棚になるので、About より先に「作っているもの」が目に入る。 -#}
  <section class="blk blk--green hero" style="--next: var(--paper)">
    <div class="wrap">
      <p class="hero__sub">{{ t.home.heroSub }}</p>
      {#- 一行版のロゴ（角を丸めた抜き版）。横に長いので、大看板の幅にそのまま乗る。 -#}
      <h1 class="hero__type">
        <img src="/assets/brand/wordline-cream.png" alt="{{ t.home.title }}" width="700" height="234">
      </h1>
      <p class="hero__line">{{ t.home.heroLine }}</p>
      <ul class="stickers">
        {%- for s in t.home.stickers %}
        <li class="sticker">{{ s }}</li>
        {%- endfor %}
      </ul>
      <p class="hero__nav">
        <a href="#apps">{{ t.home.navApps }}</a>
        <a href="#about">{{ t.home.navAbout }}</a>
        {%- if pages.comingSoon.length %}<a href="#soon">{{ t.home.navSoon }}</a>{% endif %}
        <a href="#contact">{{ t.home.navContact }}</a>
      </p>
    </div>
  </section>

  {#- 棚。画面写真が主役で、名前とタグはその下に添える。 -#}
  <section class="blk blk--paper" id="apps" style="--next: var(--paper-2)">
    <div class="wrap">
      <h2 class="dh">
        <span class="dh__en">{{ t.home.headings.released }}</span>
        {%- if lang != "en" %}<span class="dh__ja">{{ t.home.releasedHeading }}</span>{% endif %}
      </h2>
      <p class="shelf__note">{{ t.home.shelfNote }}</p>
      <ul class="shelf">
        {%- for item in pages.released %}
        {%- set appLang = lang if lang in item.languages else item.defaultLanguage %}
        {%- set c = appColors[item.slug] %}
        <li class="shelf__card"{% if c %} style="--tint: {{ c.tintLight }}"{% endif %}>
          <div class="shelf__shot">
            {%- if item.screenshots %}
            <img src="/assets/apps/{{ item.slug }}/screenshot-1.jpg" alt="" width="1320" height="2868" loading="lazy">
            {%- else %}
            <img class="shelf__shot--icon" src="/assets/apps/{{ item.slug }}/icon-192.png" alt="" width="192" height="192" loading="lazy">
            {%- endif %}
          </div>
          <div class="shelf__body">
            <h3 class="shelf__name">
              <a href="/{{ appLang }}/{{ item.slug }}/">{{ item.name | loc(lang) }}</a>
              {%- if item.slug == pages.newest %} <span class="badge badge--new">{{ t.home.latestBadge }}</span>{% endif %}
            </h3>
            <p class="shelf__tagline">{{ item.tagline | loc(lang) }}</p>
            {%- set tags = item.tags | locStrict(lang) %}
            {%- if tags %}
            <ul class="shelf__tags">
              {%- for tag in tags %}<li>{{ tag }}</li>{% endfor %}
            </ul>
            {%- endif %}
            {%- if item.appStoreUrl %}
            <p class="shelf__store"><a href="{{ item.appStoreUrl | storeLink('gcl_home') }}">{{ t.app.openStore }}</a></p>
            {%- endif %}
          </div>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </section>

  <section class="blk blk--paper2" id="about" style="--next: var(--ink)">
    <div class="wrap">
      <h2 class="dh">
        <span class="dh__en">{{ t.home.headings.about }}</span>
        {%- if lang != "en" %}<span class="dh__ja">{{ t.home.aboutHeading }}</span>{% endif %}
      </h2>
      <p class="big">{{ t.home.lead }}</p>
      <ul class="stance">
        {%- for item in t.home.stance %}
        <li data-reveal>{{ item }}</li>
        {%- endfor %}
      </ul>
    </div>
  </section>

  {%- if pages.comingSoon.length %}
  <section class="blk blk--ink" id="soon" style="--next: var(--green)">
    <div class="wrap">
      <h2 class="dh">
        <span class="dh__en">{{ t.home.headings.comingSoon }}</span>
        {%- if lang != "en" %}<span class="dh__ja">{{ t.home.comingSoonHeading }}</span>{% endif %}
      </h2>
      <p>{{ t.home.comingSoonNote }}</p>
      <ul class="app-grid">
        {%- for item in pages.comingSoon %}
        <li class="app-card app-card--quiet" data-reveal>
          <span class="app-card__icon">
            <img src="/assets/apps/{{ item.slug }}/icon-192.png" alt="" width="72" height="72" loading="lazy">
          </span>
          <div class="app-card__body">
            <h3 class="app-card__name">{{ item.name | loc(lang) }} <span class="badge">{{ t.app.comingSoonBadge }}</span></h3>
            <p class="app-card__tagline">{{ item.tagline | loc(lang) }}</p>
            {%- set tags = item.tags | locStrict(lang) %}
            {%- if tags %}
            <ul class="shelf__tags shelf__tags--quiet">
              {%- for tag in tags %}<li>{{ tag }}</li>{% endfor %}
            </ul>
            {%- endif %}
          </div>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </section>
  {%- endif %}

  <section class="blk blk--green" id="contact" style="--next: var(--bg)">
    <div class="wrap">
      <img class="hero__stamp" src="/assets/brand/stamp-cream.png" alt="" width="520" height="516" loading="lazy">
      <h2 class="dh">
        <span class="dh__en">{{ t.home.headings.contact }}</span>
        {%- if lang != "en" %}<span class="dh__ja">{{ t.home.contactHeading }}</span>{% endif %}
      </h2>
      <p>{{ t.home.contactLead }}</p>
      <dl class="contact-list">
        <dt>{{ t.home.contactSupportLabel }}</dt>
        <dd><a href="mailto:{{ site.email.support }}">{{ site.email.support }}</a></dd>
        <dt>{{ t.home.contactPrivacyLabel }}</dt>
        <dd><a href="mailto:{{ site.email.privacy }}">{{ site.email.privacy }}</a></dd>
      </dl>
    </div>
  </section>

</div>
