---
pagination:
  data: pages.fallbacks
  size: 1
  alias: target
permalink: "/{{ target.lang }}/{{ target.app.slug }}/{{ target.page }}/"
---
{#- 未対応言語のURL。head の meta refresh と canonical で既定言語のページへ送る #}
<h1>{{ t.fallback.title }}</h1>
<p>{{ t.fallback.body }}</p>
<p><a href="{{ redirectTo }}">{{ t.fallback.manualLink }}</a></p>
