<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in pages.sitemapUrls %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    <priority>{{ item.priority }}</priority>
  </url>
{%- endfor %}
</urlset>
