<!DOCTYPE html>
<html lang="{{ t.htmlLang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    {%- if description %}
    <meta name="description" content="{{ description }}">
    {%- endif %}
    {%- if noindex %}
    <meta name="robots" content="noindex, follow">
    {%- endif %}
    {%- if redirectTo %}
    <meta http-equiv="refresh" content="0; url={{ redirectTo }}">
    <link rel="canonical" href="{{ site.url }}{{ redirectTo }}">
    {%- else %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    {%- endif %}
    {%- for alt in alternates %}
    <link rel="alternate" hreflang="{{ alt.lang }}" href="{{ site.url }}{{ alt.url }}">
    {%- endfor %}

    {#- SNS に貼られたときのカード #}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name | loc(lang) }}">
    <meta property="og:title" content="{{ title }}">
    {%- if description %}
    <meta property="og:description" content="{{ description }}">
    {%- endif %}
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}{{ ogImage }}">
    <meta property="og:locale" content="{% if lang == 'ja' %}ja_JP{% else %}en_US{% endif %}">
    <meta name="twitter:card" content="summary">

    {#- iPhone で開いた人に App Store への案内を出す #}
    {%- if smartBannerId %}
    <meta name="apple-itunes-app" content="app-id={{ smartBannerId }}">
    {%- endif %}

    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#224a38">
    <link rel="icon" href="/assets/brand/mark-32.png" sizes="32x32">
    <link rel="icon" href="/assets/brand/mark-512.png" sizes="512x512">
    <link rel="apple-touch-icon" href="/assets/brand/mark-180.png">
    <link rel="stylesheet" href="/assets/css/style.css?v={{ assets.cssVersion }}">
    {#- 描画前に印を付けておき、登場アニメーションのちらつきを防ぐ。
        4秒経っても enhance.js が動かなければ、印を外して内容を必ず表示する。 #}
    <script>
      (function(d){var r=d.documentElement;
        if(!('IntersectionObserver' in window)) return;
        if(matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        r.classList.add('js-anim');
        setTimeout(function(){if(!r.classList.contains('js-ready'))r.classList.remove('js-anim');},4000);
      })(document);
    </script>

    {#- 構造化データ #}
    {%- if kind == "home" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "{{ site.name | loc(lang) }}",
      "url": "{{ site.url }}/{{ lang }}/",
      "logo": "{{ site.url }}/assets/brand/mark-512.png",
      "email": "{{ site.email.support }}"
    }
    </script>
    {%- elif kind == "intro" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "{{ app.name | loc(lang) }}",
      "description": "{{ description }}",
      "url": "{{ site.url }}{{ page.url }}",
      "image": "{{ site.url }}/assets/apps/{{ app.slug }}/icon-512.png",
      "operatingSystem": "iOS",
      {%- if app.appStore %}
      "applicationCategory": "{{ app.appStore.category.en }}",
      "installUrl": "{{ app.appStore.url }}",
      {%- endif %}
      "author": {
        "@type": "Organization",
        "name": "{{ site.name | loc(lang) }}",
        "url": "{{ site.url }}/{{ lang }}/"
      }
    }
    </script>
    {%- endif %}
  </head>
  <body>
    <a class="skip-link" href="#main">{{ t.nav.skipToContent }}</a>
    {% include "partials/header.njk" %}
    <main id="main" class="{% if kind == 'home' or kind == 'intro' %}main--full{% else %}wrap{% endif %}">
      {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
    <script src="/assets/js/enhance.js?v={{ assets.cssVersion }}" defer></script>
  </body>
</html>
