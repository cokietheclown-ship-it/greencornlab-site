{#- アプリの紹介ページ。App Store の外に置く、唯一の入口。
    本文は src/_data/apps/<slug>.json の intro に入っている。
    intro がまだ無いアプリ（公開直後など）は、description とスクリーンショットだけで組む。 #}
{%- set appName = app.name | loc(lang) %}
{%- set intro = app.intro | locStrict(lang) %}

<div class="app-hero">
  <div class="wrap app-hero__inner">
    <img class="app-hero__icon" src="/assets/apps/{{ app.slug }}/icon-512.png"
         alt="{{ t.app.iconAlt | fill({ app: appName }) }}" width="112" height="112">
    <div class="app-hero__text">
      <h1 class="app-hero__title">{{ intro.title if intro and intro.title else appName }}</h1>
      <p class="app-hero__tagline">{{ intro.tagline if intro and intro.tagline else app.tagline | loc(lang) }}</p>
      {%- if app.appStore %}
      <p class="app-hero__meta">{{ app.appStore.category | loc(lang) }} ・ {{ app.platform }}</p>
      {%- endif %}
      {%- if app.appStoreUrl %}
      <p class="app-hero__cta">
        <a class="button" href="{{ app.appStoreUrl | storeLink('gcl_intro_' + app.slug) }}">{{ t.app.getOnStore }}</a>
      </p>
      {%- endif %}
    </div>
  </div>
</div>

<div class="wrap">
  <article class="intro">
    {%- if intro %}
    {%- for para in intro.lead %}
    <p class="lead">{{ para }}</p>
    {%- endfor %}
    {%- else %}
    <p class="lead">{{ app.description | loc(lang) }}</p>
    {%- endif %}

    {%- if intro and intro.price %}
    <p class="note">{{ intro.price }}</p>
    {%- endif %}

    {%- if app.screenshots %}
    <section class="shots">
      <h2>{{ t.app.screenshotsHeading }}</h2>
      <ul class="shots__list">
        {%- for n in range(1, app.screenshots + 1) %}
        <li>
          <img src="/assets/apps/{{ app.slug }}/screenshot-{{ n }}.jpg"
               alt="{{ t.app.screenshotAlt | fill({ app: appName, n: n }) }}"
               loading="lazy" decoding="async">
        </li>
        {%- endfor %}
      </ul>
    </section>
    {%- endif %}

    {%- for section in intro.sections if intro %}
    <section>
      <h2>{{ section.heading }}</h2>
      {%- for para in section.body %}
      <p>{{ para }}</p>
      {%- endfor %}
      {%- if section.list %}
      <ul>
        {%- for item in section.list %}
        <li>{{ item }}</li>
        {%- endfor %}
      </ul>
      {%- endif %}
    </section>
    {%- endfor %}

    {%- if app.appStoreUrl %}
    <section class="cta-block">
      <h2>{{ t.intro.downloadHeading }}</h2>
      <p>{{ t.intro.downloadLead | fill({ app: appName, platform: app.platform }) }}</p>
      <p class="app-hero__cta">
        <a class="button" href="{{ app.appStoreUrl | storeLink('gcl_intro_foot_' + app.slug) }}">{{ t.intro.download | fill({ app: appName }) }}</a>
      </p>
    </section>
    {%- endif %}

    {%- if intro and intro.disclaimer %}
    <p class="note">{{ intro.disclaimer }}</p>
    {%- endif %}

    <p class="crosslink">
      <a href="/{{ lang }}/{{ app.slug }}/support/">{{ t.nav.support }}</a>
      <a href="/{{ lang }}/{{ app.slug }}/privacy/">{{ t.nav.privacy }}</a>
    </p>
  </article>
</div>
