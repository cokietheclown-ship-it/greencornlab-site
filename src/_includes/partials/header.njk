<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__brand" href="/{{ lang }}/">
      <picture>
        <source srcset="/assets/brand/logo-cream-1200.png" media="(prefers-color-scheme: dark)">
        <img src="/assets/brand/logo-ink-1200.png" alt="{{ site.name | loc(lang) }}">
      </picture>
    </a>
    {%- set others = [] %}
    {%- for alt in alternates %}
      {%- if alt.lang != lang %}{% set others = (others.push(alt), others) %}{% endif %}
    {%- endfor %}
    {%- if others.length %}
    <nav class="lang-switch" aria-label="Language">
      {%- for alt in others %}
      <a href="{{ alt.url }}" hreflang="{{ alt.lang }}" lang="{{ alt.lang }}">{{ i18n[alt.lang].langName }}</a>
      {%- endfor %}
    </nav>
    {%- endif %}
  </div>
</header>
