<header class="site-header">
  <div class="wrap site-header__inner">
    {#- トップは大看板で屋号を出しているので、ヘッダーはとうもろこしだけにする。
        同じ一行ロゴを1画面に2回出さない。 -#}
    {%- if kind == "home" %}
    <a class="site-header__brand site-header__brand--mark" href="/{{ lang }}/" aria-label="{{ site.name | loc(lang) }}">
      <picture>
        <source srcset="/assets/brand/mark-cream.png" media="(prefers-color-scheme: dark)">
        <img src="/assets/brand/mark-color.png" alt="" width="360" height="396">
      </picture>
    </a>
    {%- else %}
    <a class="site-header__brand" href="/{{ lang }}/">
      <picture>
        <source srcset="/assets/brand/wordline-cream.png" media="(prefers-color-scheme: dark)">
        <img src="/assets/brand/wordline-green.png" alt="{{ site.name | loc(lang) }}">
      </picture>
    </a>
    {%- endif %}
    {%- set others = [] %}
    {%- for alt in alternates %}
      {%- if alt.lang != lang %}{% set others = (others.push(alt), others) %}{% endif %}
    {%- endfor %}
    {%- if others.length %}
    <nav class="lang-switch" aria-label="Language">
      {%- for alt in others %}
      <a href="{{ alt.url }}" hreflang="{{ alt.lang }}" lang="{{ alt.lang }}">{{ i18n[alt.lang].langName }}</a>
      {%- endfor %}
    </nav>
    {%- endif %}
  </div>
</header>
